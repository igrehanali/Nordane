# --- Database -----------------------------------------------------------------
# Neon pooled connection string. Create a free project at https://neon.tech,
# then copy the "Pooled connection" string from the dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32   (or)   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default trading region: US | UK | AU. Controls currency, tax label, date and
# address formatting. Can also be changed at runtime in Back office > Settings.
REGION="US"

# Shows the "Explore as..." demo buttons on the login page and enables the
# nightly demo-data reset. Set to "false" for a real deployment.
DEMO_MODE="true"

# Secret used to authenticate the nightly demo reset cron request.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET="replace-me"

# --- Email --------------------------------------------------------------------
# console = order confirmations are printed to the server log (default, no account needed)
# resend  = send for real; requires RESEND_API_KEY and EMAIL_FROM
EMAIL_TRANSPORT="console"
# RESEND_API_KEY=""
# EMAIL_FROM="orders@brightwatertrade.example"
